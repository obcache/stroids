{
  "name": "stroids",
  "version": "0.1.0",
  "private": false,
  "description": "retro homage to asteroids",
  "main": "build/electron/main.js",
  "author": "STROIDS contributors",
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node tools/build/dev.js",
    "build:icons": "node tools/build/icons.js",
    "build:notices": "node tools/build/notices.js",
    "format": "prettier --write src electron shared tests tools/build tools/testing vite.config.mts tsconfig.json tsconfig.electron.json package.json",
    "build": "npm run build:icons && npm run build:notices && npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:smoke": "node tools/testing/smoke.js",
    "test:desktop": "node tools/testing/desktop.js",
    "test:installer": "node tools/testing/installer.js",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "package": "npm run build && node tools/build/package.js",
    "deploy:check": "node tools/build/deploy-check.js",
    "todo": "node tools/project-mgmt/todo.js list",
    "todo:add": "node tools/project-mgmt/todo.js add",
    "ledger:list": "node tools/project-mgmt/ledger.js list",
    "ledger:message": "node tools/project-mgmt/ledger.js message",
    "handoff": "node tools/project-mgmt/handoff.js",
    "version:show": "node tools/project-mgmt/version-show.js",
    "version:sync": "node tools/project-mgmt/version-sync.js",
    "version:bump:patch": "node tools/project-mgmt/version-bump.js patch",
    "version:bump:minor": "node tools/project-mgmt/version-bump.js minor",
    "version:bump:major": "node tools/project-mgmt/version-bump.js major",
    "commit": "node tools/project-mgmt/commit-release.js patch",
    "commit:minor": "node tools/project-mgmt/commit-release.js minor",
    "commit:major": "node tools/project-mgmt/commit-release.js major"
  }
}
